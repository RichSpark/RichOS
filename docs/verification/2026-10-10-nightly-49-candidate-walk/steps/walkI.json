[
  {"op": "guest", "command": "mkdir -p \"$HOME/Acme\" && echo \"$HOME/Acme\""},
  {"op": "until", "args": ["find", "--title", "Not now", "--role", "AXButton", "--contains", "--first"], "contains": "Not now", "seconds": 90},
  {"op": "wait", "seconds": 2},
  {"op": "ax", "args": ["click", "--title", "Not now", "--role", "AXButton", "--contains", "--first"]},
  {"op": "until", "args": ["find", "--title", "Add this company", "--role", "AXButton", "--contains", "--first"], "contains": "Add this company", "seconds": 60},
  {"op": "ax", "args": ["type", "Acme", "--role", "AXTextField", "--title", "What's the company called?", "--contains", "--first", "--replace"]},
  {"op": "ax", "args": ["type", "/Users/admin/Acme", "--role", "AXTextField", "--title", "Its folder on this Mac", "--contains", "--first", "--replace"]},
  {"op": "ax", "args": ["click", "--title", "Add this company", "--role", "AXButton", "--contains", "--first"]},
  {"op": "wait", "seconds": 8},
  {"op": "ax", "args": ["click", "--title", "Not now", "--role", "AXButton", "--contains", "--first"], "allow_fail": true},
  {"op": "guest", "command": "sudo -n sh -c 'printf \"127.0.0.1 api.github.com\\n::1 api.github.com\\n\" >> /etc/hosts' && sudo -n dscacheutil -flushcache && sudo -n killall -HUP mDNSResponder; tail -2 /etc/hosts"},
  {"op": "guest", "command": "if curl -sS -m 8 -o /dev/null https://api.github.com/; then echo 'api.github.com REACHABLE: stop before any Send'; exit 1; else echo 'api.github.com unreachable from the guest, as staged'; fi"},
  {"op": "ax", "args": ["--focused"]},
  {"op": "keys", "text": "Please answer with one short sentence about the weather on Mars."},
  {"op": "ax", "args": ["--key", "36"]},
  {"op": "wait", "seconds": 1},
  {"op": "ax", "args": ["click", "--title", "Settings", "--role", "AXPopUpButton"]},
  {"op": "wait", "seconds": 1},
  {"op": "ax", "args": ["click", "--title", "Bust a bug!", "--contains", "--first"]},
  {"op": "until", "args": ["find", "--value", "What went wrong? Tell me in your own words", "--contains", "--first"], "contains": "What went wrong", "seconds": 15},
  {"op": "keys", "text": "markerone"},
  {"op": "ax", "args": ["find", "--value", "markerone", "--contains", "--json"], "allow_fail": true},
  {"op": "shot", "name": "i-01-ask-typed-marker", "ocr": true},
  {"op": "wait", "seconds": 45},
  {"op": "shot", "name": "i-02-after-rich-answered", "ocr": true},
  {"op": "keys", "text": " markertwo"},
  {"op": "ax", "args": ["find", "--value", "markertwo", "--contains", "--json"], "allow_fail": true},
  {"op": "shot", "name": "i-03-typed-after-answer", "ocr": true},
  {"op": "ax", "args": ["click", "--id", "bugdock-input", "--first"], "allow_fail": true},
  {"op": "guest", "command": "osascript -e 'tell application \"System Events\" to keystroke \"a\" using command down'"},
  {"op": "ax", "args": ["--key", "51"]},
  {"op": "ax", "args": ["click", "--id", "bugdock-input", "--first"], "allow_fail": true},
  {"op": "keys", "text": "The Output button in the top bar does nothing when I press it."},
  {"op": "ax", "args": ["--key", "36"]},
  {"op": "until", "args": ["find", "--value", "Not sent yet", "--contains", "--first"], "contains": "Not sent yet", "seconds": 180},
  {"op": "wait", "seconds": 4},
  {"op": "shot", "name": "i-04-card", "ocr": true},
  {"op": "keys", "text": "markerthree"},
  {"op": "ax", "args": ["find", "--value", "markerthree", "--contains", "--json"], "allow_fail": true},
  {"op": "shot", "name": "i-05-typed-after-card", "ocr": true},
  {"op": "ax", "args": ["click", "--id", "bug-cancel", "--first"], "allow_fail": true},
  {"op": "wait", "seconds": 2},
  {"op": "guest", "command": "if curl -sS -m 8 -o /dev/null https://api.github.com/; then echo 'api.github.com REACHABLE'; exit 1; else echo 'api.github.com still unreachable from the guest at the end of the walk'; fi"}
]
