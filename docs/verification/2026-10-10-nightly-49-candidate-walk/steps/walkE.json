  {"op": "guest", "command": "d=$(find /Users/admin/testvm -type d -name bug-reports 2>/dev/null | head -1); echo \"store: ${d:-none}\"; [ -n \"$d\" ] && find \"$d\" -name '*.json' -exec python3 -c 'import json,sys; r=json.load(open(sys.argv[1])); print(json.dumps({k: r[k] for k in r if k in (\"title\",\"reason\",\"state\")})); print(r.get(\"body\",\"\")[:700])' {} \\; ; [ -n \"$d\" ] && { cat \"$d/sent.jsonl\" 2>&1; }; true"},
