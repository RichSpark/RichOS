[
  {"op": "guest", "command": "mkdir -p \"$HOME/Acme\" /Users/admin/qa/lib && echo ready"},
  {"op": "push", "src": "richos/app/scripts/qa/frame.py", "dest": "/Users/admin/qa/frame.py"},
  {"op": "push", "src": "richos/app/scripts/qa/lib/qaimg.py", "dest": "/Users/admin/qa/lib/qaimg.py"},
  {"op": "until", "args": ["find", "--title", "Not now", "--role", "AXButton", "--contains", "--first"], "contains": "Not now", "seconds": 90},
  {"op": "wait", "seconds": 2},
  {"op": "ax", "args": ["click", "--title", "Not now", "--role", "AXButton", "--contains", "--first"]},
  {"op": "until", "args": ["find", "--title", "Add this company", "--role", "AXButton", "--contains", "--first"], "contains": "Add this company", "seconds": 60},
  {"op": "ax", "args": ["type", "Acme", "--role", "AXTextField", "--title", "What's the company called?", "--contains", "--first", "--replace"]},
  {"op": "ax", "args": ["type", "/Users/admin/Acme", "--role", "AXTextField", "--title", "Its folder on this Mac", "--contains", "--first", "--replace"]},
  {"op": "ax", "args": ["click", "--title", "Add this company", "--role", "AXButton", "--contains", "--first"]},
  {"op": "wait", "seconds": 8},
  {"op": "ax", "args": ["click", "--title", "Not now", "--role", "AXButton", "--contains", "--first"], "allow_fail": true},
  {"op": "guest", "command": "sudo -n sh -c 'printf \"127.0.0.1 api.github.com\\n::1 api.github.com\\n\" >> /etc/hosts' && sudo -n dscacheutil -flushcache && sudo -n killall -HUP mDNSResponder; tail -2 /etc/hosts"},
  {"op": "guest", "command": "if curl -sS -m 8 -o /dev/null https://api.github.com/; then echo 'api.github.com REACHABLE: stop before any Send'; exit 1; else echo 'api.github.com unreachable from the guest, as staged'; fi"},
  {"op": "ax", "args": ["click", "--title", "Quit RichOS", "--role", "AXMenuItem", "--in", "menubar", "--first"]},
  {"op": "wait", "seconds": 4},
  {"op": "guest", "command": "ps -axo pid=,comm= | grep -c 'RichOS.app/Contents/MacOS/richos-tauri$'; true"},
  {"op": "relaunch"},
  {"op": "guest", "command": "cd /Users/admin/qa && for i in $(seq 1 200); do screencapture -x -R 560,300,201,1 p.png 2>/dev/null && o=$(python3 frame.py px p.png 200 0 0 0 2>/dev/null) && a=$(echo \"$o\" | awk 'NR==1{print $NF}') && b=$(echo \"$o\" | awk 'NR==2{print $NF}') && awk -v a=\"$a\" -v b=\"$b\" 'BEGIN{exit !(a>0.6 && b<0.05)}' && break; sleep 0.05; done; osascript -e 'tell application \"System Events\" to key code 49'; echo \"space sent after $i samples; last reading: $o\""},
  {"op": "wait", "seconds": 6},
  {"op": "shot", "name": "p2-01-held-6s", "ocr": true},
  {"op": "wait", "seconds": 6},
  {"op": "shot", "name": "p2-02-held-12s"},
  {"op": "ax", "args": ["find", "--title", "Settings", "--role", "AXPopUpButton", "--first", "--json"], "allow_fail": true},
  {"op": "ax", "args": ["click", "--title", "Settings", "--role", "AXPopUpButton"]},
  {"op": "wait", "seconds": 1},
  {"op": "shot", "name": "p2-03-settings-on-held-splash", "ocr": true},
  {"op": "ax", "args": ["click", "--title", "Bust a bug!", "--contains", "--first"]},
  {"op": "until", "args": ["find", "--value", "What went wrong? Tell me in your own words", "--contains", "--first"], "contains": "What went wrong", "seconds": 15},
  {"op": "ax", "args": ["--focused"]},
  {"op": "tree", "name": "p2-04-ask-held-splash", "allow_fail": true},
  {"op": "shot", "name": "p2-04-ask-held-splash-light", "ocr": true},
  {"op": "keys", "text": "The opening screen froze and will not go away."},
  {"op": "wait", "seconds": 1},
  {"op": "ax", "args": ["--focused"]},
  {"op": "shot", "name": "p2-05-typed-held-splash"},
  {"op": "ax", "args": ["--key", "36"]},
  {"op": "until", "args": ["find", "--value", "Not sent yet", "--contains", "--first"], "contains": "Not sent yet", "seconds": 180, "allow_fail": true},
  {"op": "wait", "seconds": 4},
  {"op": "shot", "name": "p2-06-card-held-splash-light", "ocr": true},
  {"op": "guest", "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to true'"},
  {"op": "wait", "seconds": 4},
  {"op": "shot", "name": "p2-06-card-held-splash-dark", "ocr": true},
  {"op": "guest", "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to false'", "allow_fail": true}
]
