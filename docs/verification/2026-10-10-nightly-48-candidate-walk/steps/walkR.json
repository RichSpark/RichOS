[
  {"op": "guest", "command": "mkdir -p \"$HOME/Acme\" && echo \"$HOME/Acme\""},
  {"op": "until", "args": ["find", "--title", "Not now", "--role", "AXButton", "--contains", "--first"], "contains": "Not now", "seconds": 90},
  {"op": "wait", "seconds": 2},
  {"op": "ax", "args": ["click", "--title", "Not now", "--role", "AXButton", "--contains", "--first"]},
  {"op": "until", "args": ["find", "--title", "Add this company", "--role", "AXButton", "--contains", "--first"], "contains": "Add this company", "seconds": 60},
  {"op": "ax", "args": ["type", "Acme", "--role", "AXTextField", "--title", "What's the company called?", "--contains", "--first", "--replace"]},
  {"op": "ax", "args": ["type", "/Users/admin/Acme", "--role", "AXTextField", "--title", "Its folder on this Mac", "--contains", "--first", "--replace"]},
  {"op": "ax", "args": ["click", "--title", "Add this company", "--role", "AXButton", "--contains", "--first"]},
  {"op": "wait", "seconds": 8},
  {"op": "ax", "args": ["click", "--title", "Not now", "--role", "AXButton", "--contains", "--first"], "allow_fail": true},
  {"op": "guest", "command": "sudo -n sh -c 'printf \"127.0.0.1 api.github.com\\n::1 api.github.com\\n\" >> /etc/hosts' && sudo -n dscacheutil -flushcache && sudo -n killall -HUP mDNSResponder; tail -2 /etc/hosts"},
  {"op": "guest", "command": "if curl -sS -m 8 -o /dev/null https://api.github.com/; then echo 'api.github.com REACHABLE: stop before any Send'; exit 1; else echo 'api.github.com unreachable from the guest, as staged'; fi"},
  {"op": "ax", "args": ["click", "--title", "Settings", "--role", "AXPopUpButton"]},
  {"op": "wait", "seconds": 1},
  {"op": "ax", "args": ["click", "--title", "Bust a bug!", "--contains", "--first"]},
  {"op": "until", "args": ["find", "--value", "What went wrong? Tell me in your own words", "--contains", "--first"], "contains": "What went wrong", "seconds": 15},
  {"op": "keys", "text": "My colleague Dana Whitfield at Northwind Traders says the Send button flickers when she presses it, and the file ~/Documents/Client Plans/budget.xlsx did not attach."},
  {"op": "ax", "args": ["--key", "36"]},
  {"op": "until", "args": ["find", "--value", "Not sent yet", "--contains", "--first"], "contains": "Not sent yet", "seconds": 180},
  {"op": "wait", "seconds": 4},
  {"op": "shot", "name": "r-00-card-private-light", "ocr": true},
  {"op": "ax", "args": ["find", "--value", "nothing was left out", "--contains", "--first"], "allow_fail": true},
  {"op": "ax", "args": ["find", "--value", "Left out, because", "--contains", "--first"], "allow_fail": true},
  {"op": "ax", "args": ["find", "--value", "[a person]", "--contains", "--first", "--json"], "allow_fail": true},
  {"op": "tree", "name": "r-00-card-private", "allow_fail": true},
  {"op": "ax", "args": ["click", "--id", "bug-cancel", "--first"]},
  {"op": "wait", "seconds": 3},
  {"op": "ax", "args": ["click", "--id", "nav-corrections", "--first"]},
  {"op": "wait", "seconds": 2},
  {"op": "ax", "args": ["click", "--at", "1505,131"]},
  {"op": "wait", "seconds": 2},
  {"op": "shot", "name": "r-01-settings-over-corrections-after-cancel", "ocr": true},
  {"op": "ax", "args": ["--focused"]},
  {"op": "ax", "args": ["click", "--at", "1505,131"]},
  {"op": "wait", "seconds": 2},
  {"op": "shot", "name": "r-02-settings-second-click", "ocr": true},
  {"op": "ax", "args": ["click", "--at", "1339,891"]},
  {"op": "wait", "seconds": 3},
  {"op": "ax", "args": ["--focused"]},
  {"op": "shot", "name": "r-03-ask-corrections-light", "ocr": true},
  {"op": "keys", "text": "The Corrections window shows nothing, even though I corrected a word yesterday."},
  {"op": "wait", "seconds": 1},
  {"op": "ax", "args": ["--focused"]},
  {"op": "shot", "name": "r-04-typed-corrections"},
  {"op": "ax", "args": ["--key", "36"]},
  {"op": "wait", "seconds": 100},
  {"op": "shot", "name": "r-05-card-corrections-light", "ocr": true},
  {"op": "guest", "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to true'"},
  {"op": "wait", "seconds": 4},
  {"op": "shot", "name": "r-05-card-corrections-dark", "ocr": true},
  {"op": "guest", "command": "osascript -e 'tell application \"System Events\" to tell appearance preferences to set dark mode to false'", "allow_fail": true}
]
