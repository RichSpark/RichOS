#!/usr/bin/env bash
# bin/rios — the one command line for the RichOS native iPhone app.
#
#   bin/rios test [swift test args]   the core's unit tests on this Mac (loop L1, no simulator)
#   bin/rios headless <command>       the real core, headless (loop L1')
#   bin/rios sim <command>            the same commands inside the Debug app on a simulator
#                                     this command created (loop L2)
#   bin/rios perf (--simulator UDID | --reparse DIR) --stamp FILE [perf args]
#                                     cold launch and warm return to the presented, input-ready
#                                     viewport (richos/mobile/perf/perf.py ios; perf/README.md)
#   bin/rios review-walk --commit SHA what Apple's reviewer does, on the Release app of SHA in a leased
#                                     simulator, against the live review service; writes the record
#                                     `testflight.ts upload` requires (CEO §107; Tools/review-walk.mjs)
#   bin/rios device <command>         a PHYSICAL iPhone; the only way anything touches one. Only the
#                                     Release build goes on it and every test on it tests that build
#                                     (CEO 2026-10-02); nothing uninstalls or wipes an app.
#       build | install               the Release products (built once per committed tree); install
#                                     puts them over the installed app (devicectl), data kept
#       install --push production     the test copy archived as a store build and exported ad hoc
#                                     (Tools/adhoc-signing.ts keeps its profiles through the App Store
#                                     Connect API), so its push token is a PRODUCTION one; over the
#                                     installed test copy, data kept. Walk it with `run --as-installed`
#       verify <check>                one XCUITest check against the Release app (Tools/physical-device.mjs)
#       perf --device UDID ...        cold launch and warm return on the phone (perf.py ios)
#       run|approval|procs|apps|lock|battery|syslog ...   the walk and its reads (qa/phone-ios.py)
#       crashes --device ID --out DIR [--since EPOCH]   the phone's crash and memory-kill reports for
#                                     RichConnect, copied and read (qa/phone-ios.py)
#       wifi-restore | wifi-on        read the phone's Wi-Fi switch in Settings and turn it on if off
#       wifi-off                      turn it off; refused unless the phone is on the USB cable (over Wi-Fi
#                                     the Mac would lose the phone); end with wifi-on and `device net`
#       trust --device ID --out FILE  why iOS will or will not open the app: Developer Mode, profiles,
#                                     one launch read into a cause (trust check, DNS, VPN); reads only
#       launch BUNDLE [-- args]       open ANY installed app by the one procedure: phone connected and on
#                                     Wi-Fi first (else nothing happens), open once, refused -> restart
#                                     the phone once, wait, open once more, else the exact error
#       reboot --device ID            restart the phone (devicectl), wait until its Wi-Fi carries traffic,
#                                     open RichConnect ONCE (the phone has no passcode: back usable on its own);
#                                     RICHOS_PHONE_CHECK_APP=none opens no app here or in the checks around
#                                     verify/run/perf/hold (the CEO's own app is his, 2026-10-03)
#       close BUNDLE --device ID      end that app's process, leaving the phone at its Home Screen
#       net --device ID --out FILE    what the phone itself reaches, measured before any claim about its
#                                     Wi-Fi: this Mac reaching its Wi-Fi address, and its own internet loads
#     install, launch, and verify/run/perf/hold first prove the phone's Wi-Fi carries traffic (one restart
#     with no app opened when it does not), so iOS can verify the app online (phone_net.py)
#     verify, run, perf and hold check before and after that the phone can reach Apple (phone_net.py);
#     when it cannot, they restart the phone once on their own and go on, or say why not
#       status                        the iPhone's lock: free or held, and by whom
#       hold -- <command>             run <command> holding the iPhone (many commands, one use)
#     Each holds the iPhone's lock for its whole length; --wait SECONDS waits for another holder.
#   bin/rios --help                   every command
#
# Build output never lands in the repository: SwiftPM's scratch directory, DerivedData and the
# generated Xcode project live under the effective per-checkout cache, outside the repository.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CORE="$HERE/Core"
MACHINE_LIB="$(cd "$HERE/../../engine/scripts/lib" && pwd -P)"
# shellcheck source=../../../engine/scripts/lib/machine-settings.sh
. "$MACHINE_LIB/machine-settings.sh"
richos_machine_settings || exit 2

if [ -z "${RICHOS_NATIVE_IOS_CACHE:-}" ]; then
  RICHOS_NATIVE_IOS_CACHE="$(python3 "$MACHINE_LIB/machine_settings.py" cache richos-native-ios)" || exit 2
  RICHOS_NATIVE_IOS_CACHE="$RICHOS_NATIVE_IOS_CACHE/$(printf '%s' "$HERE" | shasum -a 256 | cut -c1-10)"
fi
RICHOS_NATIVE_IOS_CACHE="$(python3 "$MACHINE_LIB/machine_settings.py" validate "$RICHOS_NATIVE_IOS_CACHE")" || exit 2
mkdir -p "$RICHOS_NATIVE_IOS_CACHE"
export RICHOS_NATIVE_IOS_CACHE
export RICHOS_NATIVE_IOS_ROOT="$HERE"
# Clang's module cache would otherwise land under the home directory.
export CLANG_MODULE_CACHE_PATH="$RICHOS_NATIVE_IOS_CACHE/module-cache"
SCRATCH="$RICHOS_NATIVE_IOS_CACHE/spm"

if [ "${1:-}" = "perf" ]; then
  shift
  PYTHONDONTWRITEBYTECODE=1 exec python3 "$HERE/../perf/perf.py" ios "$@"
fi

if [ "${1:-}" = "review-walk" ]; then
  shift
  PYTHONDONTWRITEBYTECODE=1 exec node "$HERE/Tools/review-walk.mjs" "$@"
fi

if [ "${1:-}" = "device" ]; then
  shift
  # The tools below refuse a phone unless this verb started them (richos/mobile/physical.py).
  # One user per phone: each command holds the iPhone's lock for its whole length (a UI-test
  # session, a perf series); another holder means a refusal naming it, or a wait of at most
  # --wait seconds (RICHOS_DEVICE_WAIT). `device status` says free or held, and by whom.
  export RICHOS_DEVICE_VERB=rios PYTHONDONTWRITEBYTECODE=1
  PHYS="$HERE/../physical.py"
  wait="${RICHOS_DEVICE_WAIT:-0}"; rest=()
  while [ "$#" -gt 0 ]; do
    case "$1" in --wait) wait="${2:-}"; shift 2 || shift $# ;; *) rest+=("$1"); shift ;; esac
  done
  set -- ${rest[@]+"${rest[@]}"}
  HOLD=(python3 "$PHYS" hold --platform ios --phone iphone --wait "$wait" --)
  # The commands that USE the phone also check, before and after, that it can reach Apple (iOS verifies
  # a development-signed app online: without it "Unable to Verify App", CEO 2026-10-02) and put its
  # Wi-Fi back if a run left it off (phone_net.py).
  HOLDN=(python3 "$PHYS" hold --platform ios --phone iphone --net-check --wait "$wait" --)
  case "${1:-}" in
    status) exec python3 "$PHYS" status --platform ios --phone iphone ;;
    hold)
      shift; [ "${1:-}" = "--" ] && shift
      [ "$#" -ge 1 ] || { echo '{"ok":false,"error":"rios device hold -- <command>"}' >&2; exit 2; }
      exec "${HOLDN[@]}" "$@" ;;
    perf)
      shift
      # Unless a stamp is named: the store's Release bytes for this checkout's committed app tree
      # (`device stamp`, never a build; --expect-commit compares that commit's tree).
      named=0; pick=(); prev=""
      for a in "$@"; do
        [ "$a" = "--stamp" ] && named=1
        case "$prev" in --device|--expect-commit) pick+=("$prev" "$a") ;; esac
        prev="$a"
      done
      if [ "$named" = 0 ]; then
        out="$(node "$HERE/Tools/physical-device.mjs" stamp ${pick[@]+"${pick[@]}"})" || exit 3
        set -- "$@" --stamp "$(printf '%s' "$out" | python3 -c 'import json, sys; print(json.load(sys.stdin)["result"]["stamp"])')"
      fi
      exec "${HOLDN[@]}" python3 "$HERE/../perf/perf.py" ios "$@" ;;
    run) exec "${HOLDN[@]}" python3 "$HERE/../../app/scripts/qa/phone-ios.py" "$@" ;;
    approval|procs|apps|lock|battery|syslog|crashes|trust|net|close|wifi-restore|wifi-on|wifi-off|reboot|launch) exec "${HOLD[@]}" python3 "$HERE/../../app/scripts/qa/phone-ios.py" "$@" ;;
    verify) exec "${HOLDN[@]}" node "$HERE/Tools/physical-device.mjs" "$@" ;;
    *) exec "${HOLD[@]}" node "$HERE/Tools/physical-device.mjs" "$@" ;;
  esac
fi

if [ "${1:-}" = "test" ]; then
  shift
  exec python3 "$HERE/../../engine/scripts/lib/native-work.py" -- swift test --package-path "$CORE" --scratch-path "$SCRATCH" "$@"
fi

# Incremental: a no-op when nothing changed. Its output goes to a log so stdout stays pure JSON.
BUILD_LOG="$RICHOS_NATIVE_IOS_CACHE/cli-build.log"
if ! python3 "$HERE/../../engine/scripts/lib/native-work.py" -- swift build --package-path "$CORE" --scratch-path "$SCRATCH" --product rios-cli >"$BUILD_LOG" 2>&1; then
  tail -40 "$BUILD_LOG" >&2
  echo "{\"ok\":false,\"error\":\"rios-cli did not build; full log: $BUILD_LOG\"}" >&2
  exit 1
fi
exec "$SCRATCH/debug/rios-cli" "$@"
