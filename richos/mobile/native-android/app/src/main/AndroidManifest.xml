<?xml version="1.0" encoding="utf-8"?>
<!-- Owned by stream A1 (build plan §5.0; A3's platform features taken over by A1 while A3 is
     held). No debug-only component is declared here:
     the development bridge lives in app/src/debug/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Mac is reached over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Knowing the network came back, to reconnect at once (platform/NetworkWake.kt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice notes (round-12 groups 4-6); asked once, on the first deliberate press. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The tick when a recording locks. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Rich's replies as notifications (Android 13+ asks; FCM data messages). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scanning the Mac's pairing code, and taking a photo to send to Rich from the + menu's
         Camera; asked only when one of those is tapped. A phone without a camera still installs,
         pairs with a link and sends photos it has, so the features the permission implies are optional. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".app.RichApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.RichOS">
        <!-- Shell profiling exposes timing traces without enabling the Debug bridge. -->
        <profileable android:shell="true" />
        <!-- PORTRAIT ONLY, every activity, always (CEO, 2026-09-28: "the RichConnect app should
             NEVER show up in the landscape mode ... The user should NOT have to do anything").
             A phone lying flat on a desk has no reliable "up", so an activity that follows the
             sensor opens sideways; `portrait` holds whatever auto-rotate is set to. On phones
             (smallest width under 600dp) Android 16 still honors it at targetSdk 36; on a tablet
             or an unfolded foldable Android 16 ignores it by design. Guarded by
             app/src/test/.../app/PortraitOnlyTest.kt, which reads the merged manifest. -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share to Rich (CEO §75): photos, documents and words from any app. The types are the
             ones the Mac takes (Echo 22e59ed8); images are sent as JPEG. Exported, as a share target
             must be, so any app can start it: it shows the "Send to Rich" sheet over the app shared
             from, translucent, and sends nothing until the person presses Send (security review
             2026-09-23, A-1). Portrait like the rest of the app, even over an app that is sideways
             (a translucent activity's fixed orientation is honored from Android 8.1; minSdk is 29).
             Handles its own configuration changes so the phone switching light/dark, or a window
             resize, keeps the sheet. -->
        <activity
            android:name=".platform.ShareActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="Rich"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>
        </activity>

        <!-- Google Play services' own resolution screen, merged in with Firebase Messaging. The app
             never starts it today, but it runs in this app's window when it does, so it is held to
             portrait like every other activity in the package (merged onto the library's entry). -->
        <activity
            android:name="com.google.android.gms.common.api.GoogleApiActivity"
            android:screenOrientation="portrait"
            tools:node="merge" />

        <!-- FCM makes no token and no installation ID on its own: the app asks for the token only
             when the person turns notifications on (platform/Notifications.kt), and Forget deletes
             both for good (privacy evidence E5). Starting Firebase never creates either. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!-- The camera writes the photo it takes into this app's own cache (res/xml/camera_paths.xml)
             through this provider, which grants that one file to the camera app for that one shot. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.camera"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/camera_paths" />
        </provider>

        <!-- Share on a file Rich attached (round 36 screen 3): the kept copy in files/rich-files/ and
             nothing else (res/xml/rich_files_paths.xml), granted to the app the person shares to. -->
        <provider
            android:name=".platform.RichFilesProvider"
            android:authorities="${applicationId}.richfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rich_files_paths" />
        </provider>

        <service
            android:name=".platform.RichMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
