#!/usr/bin/env bash
# randroid — the one command line for the native RichOS Android app (build plan §3.1).
#
#   randroid headless <command> [arg]   L1′: the real core, headless, one JVM start, no Gradle
#   randroid test [core|app|all] [gradle args]   L1: JVM tests (core, CLI; app via Robolectric)
#   randroid build [debug|release]      assemble an APK (release is signed when the upload key is in
#                                       the environment, see bundle)
#   randroid build twin                 the release build's DEBUGGABLE TWIN: the same code and application
#                                       ID, debuggable, signed with the upload key (needs it in the
#                                       environment, richos-hq with-android-signing.py), so `adb install
#                                       -r` takes it over the release app with its data. Only `device
#                                       perf|seed` uses it; verify-bundle and check-release refuse it
#   randroid bundle [--allow-dirty]     the signed Android App Bundle (.aab) for Google Play, verified
#                                       as below; needs the upload key and the Firebase values in the
#                                       environment (richos-hq with-android-signing.py and
#                                       with-android-firebase.py) and a committed source tree.
#                                       Whatever key signs it, it is REFUSED without the phone speed
#                                       watch's §104 PASS for this exact app code
#                                       (richos/mobile/perf/shipgate.py, CEO §106) and without a PASSING
#                                       review walk of this exact commit (below; reviewwalk.py, CEO
#                                       §107); nothing skips either
#   randroid review-walk [--commit SHA] what Google's reviewer does, automated, on the RELEASE build of
#                                       exactly SHA (default HEAD) on this CLI's emulator, against the
#                                       live review service: sign in on the access page (headless
#                                       Chromium), get a pairing link, open it in the app, check the six
#                                       words and press They match in the app and on the page, send one
#                                       message and see the Demo reply, reset the review host. Writes the
#                                       walk record (pass or fail, every step named) that bundle reads
#   randroid verify-bundle <file.aab>   check a bundle: signed by the upload key only, permanent ID,
#                                       base module only, development bridge absent (full dex dump),
#                                       release security policy (richos/mobile/security)
#   randroid check-release              the same on the release APK and bundle (bridge, permanent
#                                       ID, release security policy); signatures when keyed
#   randroid emu prepare                L2: create + boot this checkout's emulator (-no-window),
#                                       build, install and launch the debug app
#   randroid emu refresh                incremental build + reinstall + relaunch
#   randroid emu state|reset|restart|fixture <n>|action '<json>'|transport <m>|advance <ms>|scenario <n>
#                |mac press|reject|v1|v2
#                                       the headless grammar, executed inside the app
#   randroid emu parity [scenario]      same scenario headless and on the emulator; states must match
#   randroid emu identity-check         the real Android Keystore: sign, convert to raw, verify, delete
#   randroid emu verify                 the screen shows the core's draft (UI automation dump)
#   randroid emu screenshot [file]      PNG of the emulator screen
#   randroid emu adb <args>             one adb command against this CLI's emulator (its recorded
#                                       serial only); for QA reads the grammar above has no verb for
#   randroid emu perf [perf args]       launch, resume, input, idle-frame and background measurement
#                                       of the installed build (richos/mobile/perf/perf.py android)
#   randroid emu stop | delete          quit the emulator this CLI started (by its recorded PID) /
#                                       also delete its AVD
#   randroid device --serial S [--wait SECONDS] <command>
#                                       a PHYSICAL phone; the only way anything touches one. Only
#                                       the release build goes on it and every command below tests
#                                       that build (CEO 2026-10-02): each refuses an emulator, and a
#                                       phone whose installed RichConnect is debuggable, with the
#                                       sentence. Nothing here uninstalls the app or clears its data.
#                                       (RANDROID_DEVICE may name the serial instead of --serial.)
#                                       One user per phone: each command holds the phone's lock for
#                                       its whole length; another holder means a refusal naming it,
#                                       or a wait of at most --wait seconds (RICHOS_DEVICE_WAIT).
#   randroid device list                the wired phones and their adb state (names no phone, contacts none)
#       status                          free or held, and by whom (never waits, never locks)
#       net                             READ ONLY: what the phone itself reaches, shown before any claim
#                                       about its network: its default network's transport, whether
#                                       Android validated it, a ping by address and by name; exit 1
#                                       when it reaches no internet
#       hold -- <command>               run <command> (a walker's script) holding the phone, so its
#                                       many device commands are one use
#       build                           the installed build: version, debuggable, configuration
#       install [APK]                   the release APK (default: `randroid build release`'s), over
#                                       the installed app with `adb install -r`, data kept; refuses a
#                                       debuggable APK; stamps it for `device perf`
#       seed [TWIN_APK] [perf args]     the made-up conversation through the release build's
#                                       debuggable twin (perf.py --seed-twin; the twin is replaced by
#                                       the release build in the same call). Without TWIN_APK the
#                                       twin is built here (`build twin`); a twin signed with another
#                                       key than the installed app is refused before anything installs
#       perf [perf args]                cold start, return from background, ... (perf.py android); the
#                                       seeded conversation goes through the twin the same way, unless
#                                       --conversation as-installed or --seed-twin APK is given
#       record FILE.mp4 [--seconds N]   a screen recording (at most 180 s)
#       condition [--seconds N] [--out DIR]
#                                       READ ONLY: what automation left running or changed on the
#                                       phone (adb-shell processes, test tools, accessibility and input
#                                       methods, animation/stay-awake/touch/density/debug settings and
#                                       who last set them, a forced battery state, input connections,
#                                       wake locks, the test copy's services) and the log read for N
#                                       seconds (default 30): lines per second and the most repeated
#                                       lines with the processes writing them. Changes nothing; DIR
#                                       keeps the raw reads (never public richos: it is the phone's)
#       texts|wait|gone|tap|node|swipe|type-file|keys|field|unlabeled|shot|burst|idle-frames|state|observe
#                                       the walk steps (richos/app/scripts/qa/phone-android.py)
#       bench [chip|coremark|empty-start|all] [--runs N] [--trials N] [--ndk DIR] [--out FILE]
#                                       hardware benchmarks: the chip, CoreMark (single/all cores),
#                                       the cold start of an empty app (installed beside RichConnect and
#                                       removed by its exact package name; richos/mobile/perf/bench)
#       hidden-send [args]            a send kept in flight across Home (qa/hidden-send-try.py)
#   randroid doctor                     the tools this command found
#
# Output is JSON; a failure exits nonzero. The command grammar and the result envelope are the
# preserved phone CLI's (richos/mobile/cli/mobile.mjs). Devices are addressed ONLY by the serial
# this CLI recorded when it booted the emulator — never a bare adb, which would reach whatever is
# attached (a physical phone included).
#
# Everything built or cached lives on the external SSD (richos/mobile/AGENTS.md):
#   $RANDROID_CACHE, or the effective richos-native-android/<checkout hash> cache.
# Gradle uses $GRADLE_USER_HOME, or the effective richos-native-android/gradle cache.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MACHINE_LIB="$(cd "$HERE/../../engine/scripts/lib" && pwd -P)"
# shellcheck source=../../../engine/scripts/lib/machine-settings.sh
. "$MACHINE_LIB/machine-settings.sh"
richos_machine_settings || exit 2
private_wrapper() {
  local common
  common="$(git -C "$HERE" rev-parse --path-format=absolute --git-common-dir)" || return
  printf '%s/richos-hq/scripts/%s\n' "$(dirname "$(dirname "$common")")" "$1"
}
PACKAGE="dev.richos.connect"
ACTIVITY="$PACKAGE/dev.richos.android.app.MainActivity"
RECEIVER="$PACKAGE/dev.richos.android.app.debug.DevBridgeReceiver"
SYSTEM_IMAGE="${RANDROID_SYSTEM_IMAGE:-system-images;android-34;google_apis;arm64-v8a}"

say_json() { python3 -c 'import json,sys; print(json.dumps(json.loads(sys.argv[1]), indent=2))' "$1"; }
fail() {  # $1 message, $2 exit code (default 1)
  python3 -c 'import json,sys; print(json.dumps({"ok": False, "error": sys.argv[1]}))' "$1" >&2
  exit "${2:-1}"
}
now_ms() { python3 -c 'import time; print(int(time.time()*1000))'; }

# --- environment ---------------------------------------------------------------------------
if [ -z "${RANDROID_CACHE:-}" ]; then
  RANDROID_CACHE="$(python3 "$MACHINE_LIB/machine_settings.py" cache richos-native-android)" || exit 2
  RANDROID_CACHE="$RANDROID_CACHE/$(printf '%s' "$HERE" | shasum | cut -c1-10)"
fi
RANDROID_CACHE="$(python3 "$MACHINE_LIB/machine_settings.py" validate "$RANDROID_CACHE")" || exit 2
CACHE="$RANDROID_CACHE"
OUT="$CACHE/out"
mkdir -p "$CACHE"
GRADLE_USER_HOME="$(python3 "$MACHINE_LIB/machine_settings.py" cache richos-native-android/gradle --key GRADLE_USER_HOME)" || exit 2
export GRADLE_USER_HOME
# Java 21 or newer: Robolectric's Android 36 sandbox refuses anything older. The first of
# $RANDROID_JAVA_HOME, $JAVA_HOME and Android Studio's bundled runtime that is 21+ wins; a shell
# whose JAVA_HOME is an older JDK (Homebrew's openjdk@17 on this Mac) is passed over, not used.
java_major() {  # $1 = a JDK home; prints its major version or nothing
  [ -x "$1/bin/java" ] && [ -f "$1/release" ] || return 0
  sed -n 's/^JAVA_VERSION="\([0-9]*\).*/\1/p' "$1/release"
}
PICKED=""
for candidate in "${RANDROID_JAVA_HOME:-}" "${JAVA_HOME:-}" "/Applications/Android Studio.app/Contents/jbr/Contents/Home"; do
  [ -n "$candidate" ] || continue
  major="$(java_major "$candidate")"
  if [ -n "$major" ] && [ "$major" -ge 21 ]; then PICKED="$candidate"; break; fi
done
if [ -n "$PICKED" ]; then export JAVA_HOME="$PICKED"; else unset JAVA_HOME; fi
export ANDROID_HOME="${ANDROID_HOME:-/opt/homebrew/share/android-commandlinetools}"
export ANDROID_AVD_HOME="$CACHE/avd"
ADB="$(command -v adb || true)"
[ -n "$ADB" ] || ADB="$ANDROID_HOME/platform-tools/adb"
EMULATOR="$ANDROID_HOME/emulator/emulator"
AVDMANAGER="$ANDROID_HOME/cmdline-tools/latest/bin/avdmanager"
AVD="randroid-$(basename "$CACHE")"
EMU_RECORD="$CACHE/emulator.json"

need_java() {
  [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ] || fail "NOT RUN: no Java 21+ runtime; set RANDROID_JAVA_HOME (Android Studio bundled JBR works)" 2
}

GRADLE=(python3 "$HERE/../../engine/scripts/lib/native-work.py" -- "$HERE/gradlew" -p "$HERE"
        --project-cache-dir "$CACHE/gradle-project" -Prichos.out="$OUT")
gradle() {
  need_java
  "${GRADLE[@]}" "$@"
}

# --- tests: every failure named, its result files copied out of $OUT -------------------------
# A test task writes its JUnit XML and HTML report into ONE folder under $OUT, and every test
# run of this checkout reuses it: on 2026-09-25 native-android-ui's run replaced the report of
# native-android-app's failing test before anyone read it, and the test's name was gone. So a
# test run holds $CACHE/test-results.lock from Gradle's start until its results are copied to
# $RICHOS_TEST_RESULTS_DIR (run-tests.sh sets it per suite) and every failing test is printed
# by name (richos/app/scripts/lib/test_results.py).
tests() {  # tests <label> <module/task>... -- <gradle tasks and args>
  local label="$1" keeper="$HERE/../../app/scripts/lib/test_results.py" collect=() r
  shift
  while [ "$1" != "--" ]; do
    r="$1"; shift
    collect+=(--collect "${r%%/*}-${r#*/}-xml=$OUT/${r%%/*}/test-results/${r#*/}"
              --collect "${r%%/*}-${r#*/}-report=$OUT/${r%%/*}/reports/tests/${r#*/}")
  done
  shift
  need_java
  [ -f "$keeper" ] || fail "missing $keeper: a failing test would not be named"
  python3 "$keeper" run --lock "$CACHE/test-results.lock" --label "randroid test $label" \
    ${RICHOS_TEST_RESULTS_DIR:+--into "$RICHOS_TEST_RESULTS_DIR"} "${collect[@]}" -- "${GRADLE[@]}" "$@"
}

# --- L1′: headless --------------------------------------------------------------------------
headless() {
  need_java
  local launcher="$OUT/cli/install/randroid-headless/bin/randroid-headless"
  local stamp="$CACHE/headless.stamp"
  local stale=1
  if [ -x "$launcher" ] && [ -f "$stamp" ]; then
    stale=0
    if [ -n "$(find "$HERE/core/src/main" "$HERE/cli/src/main" "$HERE/core/build.gradle.kts" \
                    "$HERE/cli/build.gradle.kts" "$HERE/gradle/libs.versions.toml" \
                    -newer "$stamp" -print -quit 2>/dev/null)" ]; then stale=1; fi
  fi
  if [ "$stale" -eq 1 ]; then
    gradle -q :cli:installDist >&2 || fail "the headless CLI did not build"
    touch "$stamp"
  fi
  RANDROID_SESSION="${RANDROID_SESSION:-$CACHE/headless.json}" "$launcher" "$@"
}

# --- the emulator -----------------------------------------------------------------------------
record_get() {  # $1 key
  [ -f "$EMU_RECORD" ] || return 1
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$EMU_RECORD" "$1"
}

# The serial this CLI created, and only if that emulator is still the process we started.
serial() {
  local s pid
  s="$(record_get serial 2>/dev/null)" || fail "no emulator recorded for this checkout; run: randroid emu prepare"
  pid="$(record_get pid)"
  kill -0 "$pid" 2>/dev/null || fail "the recorded emulator (pid $pid) is not running; run: randroid emu prepare"
  python3 "$HERE/../../engine/scripts/lib/testdevices.py" touch-lease --kind android-emulator --id "$CACHE"
  printf '%s' "$s"
}

# Never `adb -s ""`: an empty serial would fall through to whatever device is attached.
adb_s() {
  local s
  s="$(serial)"
  [ -n "$s" ] || exit 1
  "$ADB" -s "$s" "$@"
}

free_port() {
  local port
  for port in $(seq 5580 2 5680); do
    if ! "$ADB" devices | grep -q "^emulator-${port}[[:space:]]" \
       && ! lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 \
       && ! lsof -nP -iTCP:"$((port + 1))" -sTCP:LISTEN >/dev/null 2>&1; then
      printf '%s' "$port"; return 0
    fi
  done
  return 1
}

register_emulator_owner() {
  python3 "$HERE/../../engine/scripts/lib/testdevices.py" register --kind android-emulator \
    --id "$CACHE" --checkout "$HERE/../../.." --script randroid >/dev/null
}

emu_boot() {
  if [ -f "$EMU_RECORD" ] && kill -0 "$(record_get pid)" 2>/dev/null; then register_emulator_owner; return; fi
  [ -x "$EMULATOR" ] || fail "NOT RUN: no Android emulator at $EMULATOR" 2
  mkdir -p "$ANDROID_AVD_HOME"
  if [ ! -f "$ANDROID_AVD_HOME/$AVD.ini" ]; then
    echo no | "$AVDMANAGER" create avd -n "$AVD" -k "$SYSTEM_IMAGE" -d pixel_7 >/dev/null 2>"$CACHE/avdmanager.log" \
      || fail "could not create AVD $AVD from $SYSTEM_IMAGE (see $CACHE/avdmanager.log)"
  fi
  local port; port="$(free_port)" || fail "no free emulator port in 5580-5680"
  local t0; t0="$(now_ms)"
  # -no-window: nothing opens on the Mac's screen. The PID is captured here, at spawn, and is
  # the only process `emu stop` will ever signal.
  local pid
  pid="$(python3 "$HERE/../../engine/scripts/lib/testdevices.py" launch-android \
    --cache "$CACHE" --avd "$AVD" --port "$port" --checkout "$HERE/../../.." -- \
    "$EMULATOR" -avd "$AVD" -port "$port" -no-window -no-audio -no-boot-anim \
    -cores 2 -gpu swiftshader_indirect)" || fail "emulator launch or ownership registration failed"
  local s="emulator-$port" booted="" i
  for i in $(seq 1 360); do
    kill -0 "$pid" 2>/dev/null || fail "the emulator exited during boot (see $CACHE/emulator.log)"
    booted="$("$ADB" -s "$s" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r' || true)"
    [ "$booted" = "1" ] && break
    sleep 0.5
  done
  [ "$booted" = "1" ] || fail "the emulator did not finish booting in 180 s (see $CACHE/emulator.log)"
  echo "$(( $(now_ms) - t0 ))" > "$CACHE/boot-ms"
  emu_awake "$s"
}

# The EMULATOR's display (never the Mac's): keep it on and unlocked, so a screenshot or a UI dump
# sees the app rather than a sleeping panel (measured: an all-black capture after the default
# timeout). Also dismisses a system "isn't responding" dialog a loaded host can raise.
emu_awake() {  # $1 = the serial this CLI recorded
  "$ADB" -s "$1" shell svc power stayon true >/dev/null 2>&1 || true
  "$ADB" -s "$1" shell settings put system screen_off_timeout 1800000 >/dev/null 2>&1 || true
  "$ADB" -s "$1" shell input keyevent KEYCODE_WAKEUP >/dev/null 2>&1 || true
  "$ADB" -s "$1" shell wm dismiss-keyguard >/dev/null 2>&1 || true
  "$ADB" -s "$1" shell am broadcast -a android.intent.action.CLOSE_SYSTEM_DIALOGS >/dev/null 2>&1 || true
}

. "$HERE/bin/apk-install.sh"

emu_install() {
  local t0 t1 apk
  t0="$(now_ms)"
  gradle -q :app:assembleDebug >&2 || fail "the debug app did not build"
  t1="$(now_ms)"
  apk="$OUT/app/outputs/apk/debug/app-debug.apk"
  # The build's identity (commit, uncommitted changes, bytes) beside it; `emu perf` refuses to
  # measure an installed app whose bytes are not these.
  PYTHONDONTWRITEBYTECODE=1 python3 "$HERE/../perf/perf.py" stamp --artifact "$apk" --checkout "$HERE/../../.." \
    --paths richos/mobile/native-android > "$apk.stamp.json" || fail "could not stamp $apk"
  # Only when the installed bytes differ; never an uninstall, never a data clear.
  local installed
  installed="$(install_apk_if_changed "$ADB" "$(serial)" "$PACKAGE" "$apk")" || fail "install failed on $(serial)"
  adb_s shell am start -W -n "$ACTIVITY" >/dev/null || fail "launch failed on $(serial)"
  local t2; t2="$(now_ms)"
  say_json "{\"ok\": true, \"mode\": \"emu\", \"command\": \"$1\", \"result\": {\"serial\": \"$(serial)\", \"avd\": \"$AVD\", \"bootMs\": $(cat "$CACHE/boot-ms" 2>/dev/null || echo null), \"buildMs\": $((t1 - t0)), \"installLaunchMs\": $((t2 - t1)), \"install\": \"$installed\"}}"
}

emu_command() {  # $1 command, $2 optional argument
  local s; s="$(serial)"
  local t0; t0="$(now_ms)"
  local extra=()
  if [ "$#" -ge 2 ]; then extra=(--es arg64 "$(printf '%s' "$2" | base64 | tr -d '\n')"); fi
  local out
  out="$("$ADB" -s "$s" shell am broadcast -n "$RECEIVER" --es command "$1" ${extra[@]+"${extra[@]}"} 2>&1)" \
    || fail "broadcast failed on $s: $out"
  local code data
  code="$(printf '%s' "$out" | sed -n 's/.*Broadcast completed: result=\([0-9-]*\).*/\1/p' | tr -d '\r')"
  data="$(printf '%s' "$out" | sed -n 's/.*data="\([^"]*\)".*/\1/p' | tr -d '\r')"
  [ -n "$data" ] || fail "the app did not answer (is the debug build installed on $s?): $out"
  python3 - "$data" "$(( $(now_ms) - t0 ))" "$code" <<'PY'
import base64, json, sys
body = json.loads(base64.b64decode(sys.argv[1]))
body["roundTripMs"] = int(sys.argv[2])
stream = sys.stdout if sys.argv[3] == "0" else sys.stderr
print(json.dumps(body, indent=2) if sys.argv[3] == "0" else json.dumps(body), file=stream)
sys.exit(0 if sys.argv[3] == "0" else 1)
PY
}

emu_restart() {
  emu_awake "$(serial)"
  adb_s shell am force-stop "$PACKAGE"
  adb_s shell am start -W -n "$ACTIVITY" >/dev/null || fail "relaunch failed"
  emu_command state
}

emu_stop() {
  [ -f "$EMU_RECORD" ] || { say_json '{"ok": true, "mode": "emu", "command": "stop", "result": {"running": false}}'; return 0; }
  local s pid
  s="$(record_get serial)"; pid="$(record_get pid)"
  python3 "$HERE/../../engine/scripts/lib/testdevices.py" stop-android --cache "$CACHE" \
    || fail "emulator stop could not verify or end its recorded process"
  say_json "{\"ok\": true, \"mode\": \"emu\", \"command\": \"stop\", \"result\": {\"serial\": \"$s\", \"pid\": $pid, \"running\": false}}"
}

emu_delete() {
  python3 "$HERE/../../engine/scripts/lib/testdevices.py" stop-android --cache "$CACHE" --delete \
    || fail "emulator deletion could not verify or end its recorded process"
  say_json "{\"ok\": true, \"mode\": \"emu\", \"command\": \"delete\", \"result\": {\"avd\": \"$AVD\", \"deleted\": true}}"
}

emu_parity() {
  local name="${1:-draft-survives-restart}"
  local a b
  a="$(headless scenario "$name")" || fail "headless scenario $name failed"
  b="$(emu_command scenario "$name")" || fail "emulator scenario $name failed"
  python3 - "$a" "$b" "$name" <<'PY'
import json, sys
a, b = json.loads(sys.argv[1])["result"], json.loads(sys.argv[2])["result"]
sa = [step["state"] for step in a["trace"]] + [a["state"]]
sb = [step["state"] for step in b["trace"]] + [b["state"]]
same = sa == sb
print(json.dumps({"ok": same, "mode": "emu", "command": "parity",
                  "result": {"scenario": sys.argv[3], "steps": len(a["trace"]), "identical": same}}, indent=2))
sys.exit(0 if same else 1)
PY
}

emu_verify() {
  local expected dump
  expected="$(emu_command state | python3 -c 'import json,sys; s=json.load(sys.stdin)["result"]["state"]; print(s["draft"] or "Message Rich")')"
  emu_awake "$(serial)"
  adb_s shell am start -n "$ACTIVITY" >/dev/null 2>&1 || true
  dump=""
  local attempt
  # A dump taken while the window is changing returns "null root node"; try a few times.
  for attempt in 1 2 3 4 5; do
    adb_s shell uiautomator dump /sdcard/randroid-ui.xml >/dev/null 2>&1 || true
    dump="$(adb_s exec-out cat /sdcard/randroid-ui.xml 2>/dev/null || true)"
    case "$dump" in "<?xml"*) break ;; esac
    sleep 1
  done
  adb_s shell rm -f /sdcard/randroid-ui.xml
  case "$dump" in "<?xml"*) ;; *) fail "no UI dump from $(serial) after 5 attempts" ;; esac
  python3 - "$dump" "$expected" <<'PY'
import json, sys, xml.etree.ElementTree as ET
root = ET.fromstring(sys.argv[1])
texts = [n.get("text") for n in root.iter("node") if n.get("content-desc") == "draft" or n.get("text") == sys.argv[2]]
ok = sys.argv[2] in texts
print(json.dumps({"ok": ok, "mode": "emu", "command": "verify", "result": {"expectedOnScreen": sys.argv[2], "found": ok}}, indent=2))
sys.exit(0 if ok else 1)
PY
}

emu() {
  local command="${1:-}"; shift || true
  case "$command" in
    prepare|stop|delete) ;;
    *) register_emulator_owner ;;
  esac
  case "$command" in
    prepare) emu_boot; emu_install prepare ;;
    refresh) emu_install refresh ;;
    restart) emu_restart ;;
    state|reset|identity-check) emu_command "$command" ;;
    fixture|action|transport|advance|scenario|mac)
      [ "$#" -ge 1 ] || fail "$command needs an argument"
      emu_command "$command" "$1" ;;
    parity) emu_parity "${1:-}" ;;
    verify) emu_verify ;;
    adb)
      [ "$#" -ge 1 ] || fail "emu adb needs adb arguments"
      adb_s "$@" ;;
    perf)
      local s; s="$(serial)"
      PYTHONDONTWRITEBYTECODE=1 exec python3 "$HERE/../perf/perf.py" android --adb "$ADB" --serial "$s" \
        --kind emulator --owned-by randroid --lease "$CACHE" --checkout "$HERE/../../.." \
        --stamp "$OUT/app/outputs/apk/debug/app-debug.apk.stamp.json" "$@" ;;
    screenshot)
      local file="${1:-$CACHE/screens/$(date +%Y%m%d-%H%M%S).png}"
      mkdir -p "$(dirname "$file")"
      adb_s exec-out screencap -p > "$file"
      say_json "{\"ok\": true, \"mode\": \"emu\", \"command\": \"screenshot\", \"result\": {\"file\": \"$file\"}}" ;;
    stop) emu_stop ;;
    delete) emu_delete ;;
    *) fail "unknown emu command '$command'; see randroid --help" ;;
  esac
}

# The debuggable twin of the release build: assembleSeedTwin, signed with the upload key. Gradle's own
# up-to-date check is the reuse: unchanged source rebuilds nothing. Never signed with another key (a
# twin the phone would refuse is worthless and an unsigned one cannot be installed at all).
build_twin() {
  upload_key_present || fail "REFUSED: the debuggable twin must carry the upload key, the key of the release build on the phone; run through richos-hq scripts/with-android-signing.py" 3
  gradle -q --no-configuration-cache :app:assembleSeedTwin >&2 || fail "the debuggable twin did not build"
  built_apk seedTwin || fail "no twin APK recorded in output-metadata.json"
}

# --- a physical phone -------------------------------------------------------------------------
# The ONLY way anything touches one (CEO 2026-10-02: only the release build goes on his phones and
# every test on them tests it). The rules (release only, never an uninstall, the installed build
# checked first) live in richos/mobile/physical.py; the tools run here refuse a phone unless this
# verb started them (RICHOS_DEVICE_VERB), so no other path reaches it. One user per phone: every
# command runs inside `physical.py hold`, the phone's lock for its whole length (a perf series, a
# recording); `device hold -- <script>` keeps it across a walker's many commands, and a second
# caller is refused with the holder's name or waits `--wait SECONDS` (or RICHOS_DEVICE_WAIT).
device() {
  # --serial S and --wait S may stand before or after the command (`randroid device --serial S
  # install`, `randroid device install --serial S`, the grammar richos/mobile/perf/watch.py calls).
  local serial="${RANDROID_DEVICE:-}" wait="${RICHOS_DEVICE_WAIT:-0}" rest=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --serial) serial="${2:-}"; shift 2 || shift $# ;;
      --wait) wait="${2:-}"; shift 2 || shift $# ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  set -- ${rest[@]+"${rest[@]}"}
  local phys="$HERE/../physical.py" qa="$HERE/../../app/scripts/qa" perf="$HERE/../perf/perf.py"
  export RICHOS_DEVICE_VERB=randroid PYTHONDONTWRITEBYTECODE=1
  # The one command that names no phone: which are wired (adb's list; no phone is contacted).
  [ "${1:-}" = list ] && exec python3 "$phys" android-list --adb "$ADB"
  [ -n "$serial" ] || fail "name the phone: randroid device --serial SERIAL <command> (or RANDROID_DEVICE); never a bare adb (randroid device list names the wired ones)"
  local sub="${1:-}"; shift || true
  local hold=(python3 "$phys" hold --platform android --phone "$serial" --wait "$wait" --)
  case "$sub" in
    status) exec python3 "$phys" status --platform android --phone "$serial" ;;
    hold)
      [ "${1:-}" = "--" ] && shift
      [ "$#" -ge 1 ] || fail "hold runs a command holding the phone: randroid device --serial S hold -- <command>"
      exec "${hold[@]}" "$@" ;;
    build) exec "${hold[@]}" python3 "$phys" android-build --adb "$ADB" --serial "$serial" ;;
    install)
      local apk="" expect=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --expect-commit) expect="${2:-}"; shift 2 || shift $# ;;
          -*) fail "unknown install option '$1'; see randroid --help" ;;
          *) apk="$1"; shift ;;
        esac
      done
      if [ -z "$apk" ]; then
        # This checkout's release build, signed with the upload key when it is in the environment
        # (richos-hq with-android-signing.py); then no configuration cache, which would hold it.
        # THE TEST COPY (dev.richos.connect.perf), never the CEO's own app: it installs beside his RichConnect.
        # The copy carries Firebase's public identifiers too (CEO 2026-10-03: the test copies receive
        # notifications under their own app ID), so a copy installed without the caller wrapping this
        # command still has them: through richos-hq with-android-firebase.py when the environment
        # lacks them. The copy registers under its own package (AppPorts: context.packageName).
        local fb=() flags=()
        if upload_key_present; then flags=(--no-configuration-cache); fi
        if ! firebase_present && [ -f "$FIREBASE_WRAPPER" ]; then fb=(python3 "$FIREBASE_WRAPPER"); fi
        if [ "${#fb[@]}" -gt 0 ]; then
          need_java
          "${fb[@]}" "${GRADLE[@]}" -q ${flags[@]+"${flags[@]}"} :app:assemblePerfCopy >&2 || fail "the test copy's APK did not build"
        else gradle -q ${flags[@]+"${flags[@]}"} :app:assemblePerfCopy >&2 || fail "the test copy's APK did not build"; fi
        apk="$(built_apk perfCopy)" || fail "no test-copy APK recorded in output-metadata.json"
      fi
      case "$apk" in *-unsigned.apk)
        fail "REFUSED: $apk is unsigned, and a phone installs only a signed APK. Run through richos-hq scripts/with-android-signing.py so the release build carries the upload key" 3 ;;
      esac
      # Its identity beside it, first: `--expect-commit` is checked against it before the phone is
      # touched, and `device perf` refuses an installed app whose bytes are not these.
      python3 "$perf" stamp --artifact "$apk" --checkout "$HERE/../../.." --paths richos/mobile/native-android \
        > "$apk.stamp.json" || fail "could not stamp $apk"
      if [ -n "$expect" ]; then
        python3 - "$apk.stamp.json" "$expect" <<'PY' || exit 3
import json, sys
stamp, want = json.load(open(sys.argv[1])), sys.argv[2]
if len(want) < 7 or not str(stamp.get("commit", "")).startswith(want) or stamp.get("dirty"):
    print(json.dumps({"ok": False, "refused": f"freshness mismatch: the APK was built from {stamp.get('commit')} "
                      f"(uncommitted changes: {stamp.get('dirty')}), not {want}; nothing was installed"}), file=sys.stderr)
    sys.exit(1)
PY
      fi
      # The build and the stamp above need no phone; only the install holds it.
      exec "${hold[@]}" python3 "$phys" android-install --adb "$ADB" --serial "$serial" --apk "$apk" \
        --aapt2 "${RANDROID_AAPT2:-$ANDROID_HOME/build-tools/36.0.0/aapt2}" ;;
    net) exec "${hold[@]}" python3 "$phys" android-net --adb "$ADB" --serial "$serial" ;;
    condition) exec "${hold[@]}" python3 "$phys" android-condition --adb "$ADB" --serial "$serial" --seconds 30 "$@" ;;
    record) exec "${hold[@]}" python3 "$phys" android-record --adb "$ADB" --serial "$serial" --out "${1:?record FILE.mp4}" "${@:2}" ;;
    perf|seed)
      local extra=(--apksigner "${RANDROID_APKSIGNER:-$ANDROID_HOME/build-tools/36.0.0/apksigner}")
      if [ "$sub" = seed ]; then
        extra+=(--only seed)
        case "${1:-}" in -*|"") ;; *) extra+=(--seed-twin "$1"); shift ;; esac
      fi
      # The seeded conversation on a release build goes through its debuggable twin (install -r only,
      # the app's data kept). Built here, before the phone is held, unless one was given or the run
      # measures whatever the app holds.
      case " ${extra[*]} $* " in
        *" --seed-twin "*|*" --conversation as-installed "*|*" --conversation=as-installed "*) ;;
        *) local twin; twin="$(build_twin)" || exit $?
           extra+=(--seed-twin "$twin") ;;
      esac
      case " $* " in *" --stamp "*) ;; *)
        local rel; rel="$(built_apk perfCopy 2>/dev/null)" && [ -f "$rel.stamp.json" ] && extra+=(--stamp "$rel.stamp.json") ;;
      esac
      exec "${hold[@]}" python3 "$perf" android --adb "$ADB" --serial "$serial" --kind physical --checkout "$HERE/../../.." \
        ${extra[@]+"${extra[@]}"} "$@" ;;
    bench) exec "${hold[@]}" python3 "$HERE/../perf/bench/bench.py" --adb "$ADB" --serial "$serial" "$@" ;;
    hidden-send) exec "${hold[@]}" python3 "$qa/hidden-send-try.py" --adb "$ADB" --serial "$serial" "$@" ;;
    texts|wait|gone|tap|node|swipe|type-file|keys|field|unlabeled|shot|burst|idle-frames|state|observe)
      exec "${hold[@]}" python3 "$qa/phone-android.py" --adb "$ADB" --serial "$serial" "$sub" "$@" ;;
    *) fail "unknown device command '$sub'; see randroid --help" ;;
  esac
}

# --- the release check ------------------------------------------------------------------------
# Scans one APK for the development bridge: its classes (the debug package and core/dev) and
# its manifest entries (DevBridgeReceiver, DevBridgeInit, the devbridge authority).
#
# The dump is read as BYTES. It carries the APK's string constants verbatim, and they are not
# always UTF-8: a `sed` under a UTF-8 locale stopped at the first such byte ("RE error: illegal
# byte sequence") and the scan went on with the classes read so far (measured 2026-09-23: 11,139
# of the debug APK's 17,711). A class is counted only from a complete dump: `complete` is false
# unless dexdump exited 0 and the classes read equal the class_defs_size every dex header declares.
# `appEntry` is the positive control: the scan read the app's own MainActivity, so an empty or
# wrong archive cannot pass for a clean one.
bridge_scan() {  # $1 = apk; prints JSON {classes, classHeaders, declaredClasses, complete, appEntry, bridgeClasses, manifestMarkers}
  local bt="$ANDROID_HOME/build-tools/36.0.0" manifest
  manifest="$("$bt/aapt2" dump xmltree --file AndroidManifest.xml "$1")"
  python3 - "$bt/dexdump" "$1" "$manifest" <<'PY'
import json, re, subprocess, sys
dexdump, apk, manifest = sys.argv[1:4]
run = subprocess.run([dexdump, "-f", apk], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
declared = sum(int(n) for n in re.findall(rb"^class_defs_size\s*:\s*(\d+)", run.stdout, re.M))
headers = len(re.findall(rb"^Class #\d+", run.stdout, re.M))
classes = [c.decode("utf-8", "backslashreplace") for c in re.findall(rb"^\s*Class descriptor\s*:\s*'([^'\n]*)'", run.stdout, re.M)]
leaks = [c for c in classes if c.startswith("Ldev/richos/android/app/debug/") or c.startswith("Ldev/richos/android/core/dev/")]
markers = [m for m in ("dev.richos.android.app.debug", "DevBridge", "devbridge") if m in manifest]
debuggable = bool(re.search(r"android:debuggable\(0x0101000f\)=(?:true|0xffffffff)", manifest))
package = re.search(r'A: package="([^"]*)"', manifest)
code = re.search(r'versionCode\(0x0101021b\)=(\d+)', manifest)
name = re.search(r'versionName\(0x0101021c\)="([^"]*)"', manifest)
print(json.dumps({"classes": len(classes), "classHeaders": headers, "declaredClasses": declared, "dexdumpExit": run.returncode,
                  "complete": run.returncode == 0 and declared > 0 and declared == headers == len(classes),
                  "appEntry": "Ldev/richos/android/app/MainActivity;" in classes,
                  "bridgeClasses": leaks[:20], "bridgeClassCount": len(leaks), "manifestMarkers": markers,
                  "package": package.group(1) if package else None, "debuggable": debuggable,
                  "versionCode": int(code.group(1)) if code else None,
                  "versionName": name.group(1) if name else None}))
PY
}

# The release security policy (security review 2026-09-23, finding R-1): debuggable, test-only,
# backup, cleartext and network config, exported components, deep links, bridge markers, read from
# the merged manifest by richos/mobile/security/release_policy.py. A bundle's manifest is in
# aapt2's proto format, whose dump writes a typed value as `=false (Raw: "false")` where the binary
# APK dump writes `=false`; the policy reads the binary form, so the suffix on a typed (unquoted)
# value is removed first. Measured 2026-09-23: without that, the release bundle "failed" A4 and A6
# on attributes that were in fact false.
release_policy() {  # $1 = apk (binary, or a bundle's base as a proto APK); prints the policy's lines, exits with its code
  "$ANDROID_HOME/build-tools/36.0.0/aapt2" dump xmltree --file AndroidManifest.xml "$1" \
    | sed -E 's/^( *A: [^"]*=[^" ]+) \(Raw: "[^"]*"\)$/\1/' \
    | python3 "$HERE/../security/release_policy.py" android-manifest -
}

# The APK a release or debug build just wrote, named by AGP's own output-metadata.json (the name
# changes with signing: app-release.apk signed, app-release-unsigned.apk not).
built_apk() {  # $1 = debug | release | perfCopy | seedTwin, $2 = the build's output folder (default $OUT)
  python3 - "${2:-$OUT}/app/outputs/apk/$1" <<'PY'
import json, os, sys
d = sys.argv[1]
meta = json.load(open(os.path.join(d, "output-metadata.json")))
files = [e["outputFile"] for e in meta["elements"]]
if len(files) != 1: sys.exit(f"expected one APK in {d}, found {files}")
print(os.path.join(d, files[0]))
PY
}

# The upload key and the Firebase values reach Gradle only as ORG_GRADLE_PROJECT_* variables from
# the richos-hq wrappers; checked by name, the values are never read or printed here.
env_has() {  # $1 = prefix, $2... = keys
  python3 - "$@" <<'PY'
import os, sys
prefix, keys = sys.argv[1], sys.argv[2:]
sys.exit(0 if all(os.environ.get(prefix + k, "").strip() for k in keys) else 1)
PY
}
upload_key_present() { env_has ORG_GRADLE_PROJECT_richos.upload. storeFile storePassword keyAlias keyPassword; }
FIREBASE_WRAPPER="${RANDROID_FIREBASE_WRAPPER:-$(private_wrapper with-android-firebase.py)}"
firebase_present() { env_has ORG_GRADLE_PROJECT_richos.firebase. projectId appId apiKey senderId; }

# The upload certificate's SHA-256, committed (it is public: Play Console shows it). A test may
# name another with RANDROID_UPLOAD_CERT_SHA256; the result says which was used.
expected_upload_sha256() {
  if [ -n "${RANDROID_UPLOAD_CERT_SHA256:-}" ]; then printf '%s' "$RANDROID_UPLOAD_CERT_SHA256"
  else tr -d ' \n' < "$HERE/release/upload-certificate.sha256"; fi
}

JBR_BIN() { printf '%s/bin/%s' "$JAVA_HOME" "$1"; }

# A bundle's base module as a proto-format APK (manifest, resources.pb, dex at the root), which
# aapt2 and dexdump read as they read any APK, so the bundle gets the same full scan.
bundle_as_apk() {  # $1 = aab, $2 = output apk; fails on any module besides base
  python3 - "$1" "$2" <<'PY'
import sys, zipfile
aab, out = sys.argv[1:3]
with zipfile.ZipFile(aab) as z:
    names = z.namelist()
    tops = sorted({n.split("/", 1)[0] for n in names})
    allowed = {"base", "BUNDLE-METADATA", "META-INF", "BundleConfig.pb"}
    if set(tops) - allowed:
        sys.exit(f"the bundle has modules or entries the scan does not cover: {sorted(set(tops) - allowed)}")
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as o:
        o.writestr("AndroidManifest.xml", z.read("base/manifest/AndroidManifest.xml"))
        o.writestr("resources.pb", z.read("base/resources.pb"))
        dex = sorted(n for n in names if n.startswith("base/dex/") and n.endswith(".dex"))
        if not dex: sys.exit("the bundle has no dex")
        for n in dex: o.writestr(n.rsplit("/", 1)[1], z.read(n))
PY
}

# jarsigner verification of a bundle (Play accepts bundles signed this way): every entry signed,
# one signer, and that signer is the upload certificate. Not `-strict`: an upload certificate is
# self-signed by design, which -strict reports as an error.
bundle_signature() {  # $1 = aab; prints JSON {verified, unsignedEntries, signers, sha256}
  local out certs
  out="$("$(JBR_BIN jarsigner)" -verify "$1" 2>&1)" || true
  certs="$("$(JBR_BIN keytool)" -printcert -jarfile "$1" 2>&1)" || true
  python3 - "$out" "$certs" <<'PY'
import json, re, sys
out, certs = sys.argv[1:3]
sha = re.findall(r"SHA256:\s*([0-9A-F:]+)", certs)
print(json.dumps({"verified": bool(re.search(r"^jar verified\.", out, re.M)),
                  "unsignedEntries": "unsigned entries" in out or "jar is unsigned" in out,
                  "signers": len(re.findall(r"^Signer #\d+:", certs, re.M)), "sha256": sha}))
PY
}

apk_signature() {  # $1 = apk; prints JSON {verified, signers, sha256}
  local out
  out="$("$ANDROID_HOME/build-tools/36.0.0/apksigner" verify --print-certs "$1" 2>&1)" || true
  python3 - "$out" <<'PY'
import json, re, sys
out = sys.argv[1]
sha = [":".join(h[i:i+2] for i in range(0, 64, 2)).upper() for h in re.findall(r"certificate SHA-256 digest: ([0-9a-f]{64})", out)]
print(json.dumps({"verified": "DOES NOT VERIFY" not in out and bool(sha), "signers": len(sha), "sha256": sha}))
PY
}

# Verify one bundle file as it will be uploaded. $2 = required versionCode, or empty.
verify_bundle() {  # $1 = aab, $2 = expected versionCode (optional); JSON on stdout, exit 1 on failure
  local aab="$1" want="${2:-}" tmp scan sig expected from="committed"
  need_java
  [ -f "$aab" ] || fail "no bundle at $aab"
  [ -n "${RANDROID_UPLOAD_CERT_SHA256:-}" ] && from="RANDROID_UPLOAD_CERT_SHA256"
  expected="$(expected_upload_sha256)"
  tmp="$(mktemp -d "$CACHE/verify.XXXXXX")"
  if ! bundle_as_apk "$aab" "$tmp/base.apk" 2>"$tmp/err"; then
    local why; why="$(cat "$tmp/err")"; rm -rf "$tmp"; fail "bundle unreadable: $why"
  fi
  scan="$(bridge_scan "$tmp/base.apk")"
  local policy policy_code=0
  policy="$(release_policy "$tmp/base.apk")" || policy_code=$?
  rm -rf "$tmp"
  sig="$(bundle_signature "$aab")"
  python3 - "$aab" "$scan" "$sig" "$expected" "$from" "$PACKAGE" "$want" "$policy" "$policy_code" <<'PY'
import json, sys
aab, scan, sig, expected, source, package, want, policy, policy_code = sys.argv[1:10]
scan, sig = json.loads(scan), json.loads(sig)
checks = {
    "releasePolicy": policy_code == "0",
    "signedByUploadKeyOnly": sig["verified"] and not sig["unsignedEntries"] and sig["signers"] == 1 and sig["sha256"] == [expected.upper()],
    "permanentId": scan["package"] == package,
    "notDebuggable": scan["debuggable"] is False,  # the debuggable twin (randroid build twin) never ships
    "bridgeAbsent": scan["complete"] and scan["appEntry"] and scan["bridgeClassCount"] == 0 and not scan["manifestMarkers"],
    "versionCode": (scan["versionCode"] or 0) > 1 and (not want or scan["versionCode"] == int(want)),
}
ok = all(checks.values())
print(json.dumps({"ok": ok, "mode": "verify-bundle", "command": "verify-bundle",
                  "result": {"bundle": aab, "checks": checks, "package": scan["package"],
                             "versionCode": scan["versionCode"], "versionName": scan["versionName"],
                             "signer": {**sig, "expected": expected.upper(), "expectedFrom": source},
                             "releasePolicy": [l.strip() for l in policy.splitlines() if l.strip()],
                             "scan": {k: scan[k] for k in ("classes", "declaredClasses", "complete", "appEntry", "bridgeClassCount", "bridgeClasses", "manifestMarkers")}}}, indent=2))
sys.exit(0 if ok else 1)
PY
}

# The release APK and the release bundle must carry none of the bridge, must be the permanent ID
# and must pass the release security policy (release_policy above). The same scan over the debug APK must FIND the bridge, so a scanner that sees nothing cannot
# pass for a clean release. With the upload key in the environment both are signed and both
# signatures must be the upload certificate; without it they are unsigned and the result says so.
check_release() {
  local keyed=0 flags=()
  if upload_key_present; then keyed=1; flags=(--no-configuration-cache); fi
  gradle -q ${flags[@]+"${flags[@]}"} :app:assembleRelease :app:assembleDebug :app:bundleRelease >&2 \
    || fail "the release APK, the debug APK or the release bundle did not build"
  local release debug aab tmp
  release="$(built_apk release)" || fail "no release APK recorded in output-metadata.json"
  debug="$(built_apk debug)" || fail "no debug APK recorded in output-metadata.json"
  aab="$OUT/app/outputs/bundle/release/app-release.aab"
  [ -f "$release" ] && [ -f "$debug" ] && [ -f "$aab" ] || fail "missing: $release, $debug or $aab"
  tmp="$(mktemp -d "$CACHE/check.XXXXXX")"
  bundle_as_apk "$aab" "$tmp/base.apk" >&2 || { rm -rf "$tmp"; fail "the release bundle could not be read"; }
  local r d b rs bs rp bp rpc=0 bpc=0
  r="$(bridge_scan "$release")"; d="$(bridge_scan "$debug")"; b="$(bridge_scan "$tmp/base.apk")"
  rp="$(release_policy "$release")" || rpc=$?
  bp="$(release_policy "$tmp/base.apk")" || bpc=$?
  rm -rf "$tmp"
  rs='null'; bs='null'
  if [ "$keyed" -eq 1 ]; then rs="$(apk_signature "$release")"; bs="$(bundle_signature "$aab")"; fi
  python3 - "$r" "$d" "$b" "$rs" "$bs" "$release" "$aab" "$PACKAGE" "$(expected_upload_sha256)" "$keyed" "$rp" "$rpc" "$bp" "$bpc" <<'PY'
import json, sys
r, d, b, rs, bs = (json.loads(x) for x in sys.argv[1:6])
apk, aab, package, expected, keyed = sys.argv[6], sys.argv[7], sys.argv[8], sys.argv[9].upper(), sys.argv[10] == "1"
policy = {"apk": {"ok": sys.argv[12] == "0", "lines": [l.strip() for l in sys.argv[11].splitlines() if l.strip()]},
          "bundle": {"ok": sys.argv[14] == "0", "lines": [l.strip() for l in sys.argv[13].splitlines() if l.strip()]}}
def clean(s):  # a partial dump proves nothing either way: clean only when all of it was read
    return s["complete"] and s["classes"] > 0 and s["appEntry"] and s["bridgeClassCount"] == 0 and not s["manifestMarkers"]
probe = d["complete"] and d["bridgeClassCount"] > 0 and len(d["manifestMarkers"]) > 0
ids = r["package"] == package and b["package"] == package
notdebug = r["debuggable"] is False and b["debuggable"] is False  # the debuggable twin never ships
if keyed:
    signed = (rs["verified"] and rs["sha256"] == [expected]
              and bs["verified"] and not bs["unsignedEntries"] and bs["signers"] == 1 and bs["sha256"] == [expected])
    signature = {"checked": True, "ok": signed, "expected": expected, "apk": rs, "bundle": bs}
else:
    signed = True
    signature = {"checked": False, "why": "no upload key in this environment; the release outputs are unsigned (richos-hq scripts/with-android-signing.py supplies it)"}
ok = clean(r) and clean(b) and probe and ids and notdebug and signed and policy["apk"]["ok"] and policy["bundle"]["ok"]
print(json.dumps({"ok": ok, "mode": "check-release", "command": "check-release",
                  "result": {"apk": apk, "bundle": aab, "release": r, "bundleScan": b, "debugProbe": d,
                             "releaseClean": clean(r), "bundleClean": clean(b), "scannerSeesDebugBridge": probe,
                             "permanentId": ids, "notDebuggable": notdebug, "signature": signature, "releasePolicy": policy}}, indent=2))
sys.exit(0 if ok else 1)
PY
}

# The speed gate (CEO 2026-10-03, §106: nothing reaches users without passing the speed test):
# richos/mobile/perf/shipgate.py passes only with the phone speed watch's §104 PASS, cold and warm,
# for this checkout's exact app code, with no uncommitted app code. No flag skips it.
SPEED_REFUSAL=""
speed_gate() {  # returns nonzero with the refusal in SPEED_REFUSAL
  local out
  if out="$(PYTHONDONTWRITEBYTECODE=1 python3 "$HERE/../perf/shipgate.py" check --platform android --checkout "$HERE" 2>&1 >/dev/null)"; then
    return 0
  fi
  SPEED_REFUSAL="$(printf '%s\n' "${out:-REFUSED by the speed gate (CEO §106): Android: the gate did not run}" | tail -1)"
  return 1
}

# The review-walk gate (CEO 2026-10-04, §107: the CEO is never the first tester): no bundle without a
# PASSING `randroid review-walk` record for this exact commit, read by richos/mobile/perf/reviewwalk.py
# from its fixed state directory. No flag skips it. The one exception is a test's STAND-IN records
# directory, named by RICHOS_REVIEW_WALK_RECORDS (the Android suite's throwaway-key bundle, as with the
# speed gate's RICHOS_SHIP_GATE_VERDICTS); a stand-in record is judged by every rule of the real one and
# the pass line names it. Anything the gate cannot run or read refuses.
WALK_REFUSAL=""
WALK_LINE=""
WALK_RECORD=""
walk_gate() {  # $1 = the full commit; returns nonzero with the refusal in WALK_REFUSAL
  local out
  if out="$(PYTHONDONTWRITEBYTECODE=1 python3 - "$HERE/../perf" "$1" 2>&1 <<'PY'
import json, os, sys
sys.path.insert(0, sys.argv[1])
try:
    import reviewwalk
except Exception as exc:  # noqa: BLE001 - a gate that cannot load refuses
    sys.exit(f"REFUSED by the review-walk gate (CEO §107): Android build of {sys.argv[2][:12]}: the gate could not load ({exc})")
stand_in = os.environ.get("RICHOS_REVIEW_WALK_RECORDS", "")
try:
    result = reviewwalk.check("android", sys.argv[2], root=stand_in or reviewwalk.ROOT)
except reviewwalk.Refused as exc:
    sys.exit(f"REFUSED by the review-walk gate (CEO §107): {exc}")
except Exception as exc:  # noqa: BLE001 - anything unexpected refuses, never allows
    sys.exit(f"REFUSED by the review-walk gate (CEO §107): Android build of {sys.argv[2][:12]}: the gate itself failed: {type(exc).__name__}: {exc}")
print(result["line"] + (f" (STAND-IN walk records from {stand_in}, a test fixture)" if stand_in else ""))
print(result["record"])
PY
)"; then
    WALK_LINE="$(printf '%s\n' "$out" | head -1)"
    WALK_RECORD="$(printf '%s\n' "$out" | sed -n 2p)"
    return 0
  fi
  WALK_REFUSAL="$(printf '%s\n' "${out:-REFUSED by the review-walk gate (CEO §107): Android: the gate did not run}" | tail -1)"
  return 1
}

# --- the store reviewer's walk (CEO 2026-10-04, §107) -------------------------------------------
# The RELEASE build of exactly one commit, built from that commit's own files (git archive into this
# CLI's cache, so nothing uncommitted can reach it), signed with the upload key, installed fresh on
# this CLI's emulator (never a phone: `serial` is only the emulator this CLI booted), then walked by
# bin/review-walk.mjs exactly as the Google Play review notes tell the reviewer
# (richos/mobile/review-mock/README.md). The record is written whether the walk passes or fails.
# An emulator this verb booted is stopped when it ends; one that was already running is left.
SIGNING_WRAPPER="${RANDROID_SIGNING_WRAPPER:-$(private_wrapper with-android-signing.py)}"
review_walk() {
  local commit=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --commit) commit="${2:-}"; shift 2 || shift $# ;;
      *) fail "unknown review-walk option '$1'; see randroid --help" ;;
    esac
  done
  local repo sha
  repo="$(git -C "$HERE" rev-parse --show-toplevel)" || fail "not a git checkout: $HERE"
  sha="$(git -C "$repo" rev-parse --verify --quiet "${commit:-HEAD}^{commit}")" || fail "review-walk: ${commit:-HEAD} is not a commit in $repo"
  # The build Google gets is signed with the upload key and carries the Firebase values; both reach
  # Gradle only through the richos-hq wrappers, which re-run this command with them.
  if ! upload_key_present; then
    [ -f "$SIGNING_WRAPPER" ] || fail "REFUSED: no upload key in the environment and no $SIGNING_WRAPPER; the release build could not be installed" 3
    exec python3 "$SIGNING_WRAPPER" "${BASH_SOURCE[0]}" review-walk --commit "$sha"
  fi
  if ! firebase_present && [ -f "$FIREBASE_WRAPPER" ]; then
    exec python3 "$FIREBASE_WRAPPER" "${BASH_SOURCE[0]}" review-walk --commit "$sha"
  fi
  need_java
  local walk="$CACHE/review-walk"
  local src="$walk/src"
  rm -rf "$src"; mkdir -p "$src"
  git -C "$repo" archive "$sha" richos/mobile/native-android richos/mobile/conformance | tar -x -C "$src" \
    || fail "could not export $sha's Android app"
  local na="$src/richos/mobile/native-android" apk
  python3 "$HERE/../../engine/scripts/lib/native-work.py" -- "$na/gradlew" -p "$na" --project-cache-dir "$walk/gradle-project" \
    -Prichos.out="$walk/out" -q --no-configuration-cache :app:assembleRelease >&2 \
    || fail "the release build of ${sha:0:12} did not build"
  apk="$(built_apk release "$walk/out")" || fail "no release APK recorded in output-metadata.json"
  case "$apk" in *-unsigned.apk) fail "REFUSED: $apk is unsigned; the emulator installs only a signed APK" 3 ;; esac
  local booted_here=0
  if ! { [ -f "$EMU_RECORD" ] && kill -0 "$(record_get pid)" 2>/dev/null; }; then booted_here=1; fi
  if [ "$booted_here" -eq 1 ]; then
    trap 'emu_stop >/dev/null 2>&1 || true' EXIT
    # This command owns the emulator it boots, for as long as it lives (testdevices.py's lease).
    export RICHOS_TEST_DEVICE_OWNER_PID=$$
  fi
  emu_boot
  local s; s="$(serial)"
  [ -n "$s" ] || fail "no emulator serial"
  emu_awake "$s"
  # The walk itself puts the app on this emulator as a reviewer's fresh Play install (review-walk.mjs,
  # emulator serials only); this CLI's install step never uninstalls or clears data.
  local code=0
  # run-active renews the emulator's lease while the walk lives (the lease otherwise ends 900 s after
  # the boot, measured 2026-10-04: mid-walk), and ends the walk if the lease is lost.
  python3 "$HERE/../../engine/scripts/lib/testdevices.py" run-active --kind android-emulator --id "$CACHE" \
    --checkout "$HERE/../../.." -- \
    node "$HERE/bin/review-walk.mjs" --adb "$ADB" --serial "$s" --commit "$sha" --package "$PACKAGE" \
    --activity "$ACTIVITY" --apk "$apk" --writer "$HERE/../perf/reviewwalk.py" || code=$?
  # The test instance is garbage: quit it.
  "$ADB" -s "$s" shell am force-stop "$PACKAGE" >/dev/null 2>&1 || true
  return "$code"
}

# The signed bundle for Google Play. Refuses rather than produce a bundle that would upload and
# be wrong: unsigned (no upload key), unable to receive notifications (no Firebase values), built
# from uncommitted source (no commit identifies it), carrying a stale icon, or SLOWER THAN THE SPEED
# STANDARD: EVERY bundle is refused without the speed gate's pass, before anything builds, whatever key
# signs it. Google ties the app to whichever key signs its first upload, so a bundle signed with any key
# could be the one users get. (The Android suite's throwaway-key smoke test passes the gate with a
# stand-in verdict, richos/app/scripts/lib/ship_gate_fixture.py.)
bundle() {
  local allow_dirty=0
  [ "${1:-}" = "--allow-dirty" ] && allow_dirty=1
  upload_key_present || fail "REFUSED: no upload key in the environment; run through richos-hq scripts/with-android-signing.py"
  firebase_present || fail "REFUSED: no Firebase values in the environment (the app could not receive notifications); run through richos-hq scripts/with-android-firebase.py"
  local sha dirty=false
  sha="$(git -C "$HERE" rev-parse HEAD)" || fail "not a git checkout: $HERE"
  if [ -n "$(git -C "$HERE" status --porcelain -- "$HERE")" ]; then
    [ "$allow_dirty" -eq 1 ] || fail "REFUSED: uncommitted changes under $HERE; commit first (or --allow-dirty for a test bundle, which the receipt records)"
    dirty=true
  fi
  node "$HERE/release/make-app-icon.cjs" --check >&2 || fail "the launcher icon is stale; run node release/make-app-icon.cjs"
  # Every bundle, whatever key signs it: refuse before minutes of building.
  speed_gate || fail "$SPEED_REFUSAL"
  walk_gate "$sha" || fail "$WALK_REFUSAL"
  printf 'review walk: %s\n' "$WALK_LINE" >&2
  # Whole minutes from 2026-01-01T00:00Z to now (UTC): every later bundle has a higher code.
  local code
  code="$(python3 -c 'import time,calendar; print((int(time.time()) - calendar.timegm((2026,1,1,0,0,0))) // 60)')"
  # No configuration cache: its entry would hold the signing values (encrypted, key on the same disk).
  gradle -q --no-configuration-cache -Prichos.versionCode="$code" :app:bundleRelease >&2 || fail "the release bundle did not build"
  # RANDROID_RELEASE_DIR: where the bundle and its receipt go (a test sends its throwaway-key bundle
  # to scratch, so one can never sit beside the real ones).
  local built="$OUT/app/outputs/bundle/release/app-release.aab" dir="${RANDROID_RELEASE_DIR:-$CACHE/release}" file result
  [ -f "$built" ] || fail "no bundle at $built"
  mkdir -p "$dir"
  file="$dir/RichConnect-$code.aab"
  cp "$built" "$file"
  if ! result="$(verify_bundle "$file" "$code")"; then printf '%s\n' "$result" >&2; fail "the bundle failed verification: $file"; fi
  python3 - "$result" "$sha" "$dirty" "$file" "$WALK_RECORD" <<'PY'
import json, sys
result, sha, dirty, file = json.loads(sys.argv[1]), sys.argv[2], sys.argv[3] == "true", sys.argv[4]
r = result["result"]
receipt = {"bundle": file, "commit": sha, "dirty": dirty, "reviewWalk": sys.argv[5], "package": r["package"],
           "versionCode": r["versionCode"], "versionName": r["versionName"],
           "signerSha256": r["signer"]["sha256"], "signerExpectedFrom": r["signer"]["expectedFrom"],
           "checks": r["checks"]}
with open(file[:-4] + ".json", "w") as out:
    json.dump(receipt, out, indent=2); out.write("\n")
print(json.dumps({"ok": True, "mode": "bundle", "command": "bundle", "result": receipt}, indent=2))
PY
}

doctor() {
  python3 - "${JAVA_HOME:-}" "$ANDROID_HOME" "$ADB" "$EMULATOR" "$CACHE" "$GRADLE_USER_HOME" <<'PY'
import json, os, sys
keys = ["javaHome", "androidHome", "adb", "emulator", "cache", "gradleUserHome"]
print(json.dumps({"ok": True, "mode": "doctor", "command": "doctor",
                  "result": {k: {"path": v, "present": bool(v) and os.path.exists(v)} for k, v in zip(keys, sys.argv[1:])}}, indent=2))
PY
}

mode="${1:-}"; shift || true
case "$mode" in
  headless) headless "$@" ;;
  test)
    which="${1:-all}"; [ "$#" -gt 0 ] && shift
    case "$which" in
      core) tests core core/test cli/test -- :core:test :cli:test "$@" ;;
      app) tests app app/testDebugUnitTest -- :app:testDebugUnitTest "$@" ;;
      all) tests all core/test cli/test app/testDebugUnitTest -- :core:test :cli:test :app:testDebugUnitTest "$@" ;;
      *) fail "test takes core, app or all" ;;
    esac ;;
  build)
    case "${1:-debug}" in
      debug) gradle -q :app:assembleDebug; echo "$OUT/app/outputs/apk/debug/app-debug.apk" ;;
      release)
        # Signed with the upload key when it is in the environment; then no configuration cache,
        # whose entry would hold the signing values.
        if upload_key_present; then gradle -q --no-configuration-cache :app:assembleRelease
        else gradle -q :app:assembleRelease; fi
        built_apk release ;;
      twin) build_twin ;;
      *) fail "build takes debug, release or twin" ;;
    esac ;;
  bundle) bundle "$@" ;;
  review-walk) review_walk "$@" ;;
  verify-bundle)
    [ "$#" -ge 1 ] || fail "verify-bundle takes the path of an .aab"
    verify_bundle "$1" ;;
  check-release) check_release ;;
  emu) emu "$@" ;;
  device) device "$@" ;;
  doctor) doctor ;;
  ""|-h|--help|help) sed -n '2,88p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *) fail "unknown mode '$mode'; see randroid --help" ;;
esac
