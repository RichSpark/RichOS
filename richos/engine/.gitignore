/.idea/

# Generated by scripts/hooks/install.sh — machine-specific, never committed.
/.claude/settings.json

# Operational state (auto-minted, may contain local task/prompt fragments).
/.claude/state/

# Content-hash sidecars are regenerated from the current hook bytes by
# scripts/hooks/install.sh on every run. They are NOT committed, so an adopter
# never inherits a stale sidecar that fails the integrity probe against edited
# hooks.
scripts/hooks/*.sha256

# Same rule for the managed files that do not live under scripts/hooks/:
# mega-lander/workspaces.sh and mega-lander/workspaces.py (the workspace registry —
# the only code that deletes a workspace, docs/plans/worktree-spec-2026-09-11.md)
# and scripts/lib/resolve-roots.sh (the root-resolution contract — every guard
# refuses to start without it, and every guard's answer to "which repository am
# I protecting?" comes out of it). install.sh mints their sidecars.
scripts/*.sha256
scripts/lib/*.sha256
# The American spelling table and the fixer dialect-guard.sh reads it with.
scripts/lib/dialect/*.sha256
mega-lander/*.sha256
ass-kicker/*.sha256

# Native isolation worktrees — CONTENTS ignored (each is a live git worktree,
# created/removed by the orchestrator's land sequence, never committed here),
# but the directory itself ships tracked via .gitkeep so a fresh clone/copy
# already has the landing zone in place before the first agent spawns.
/.claude/worktrees/*
!/.claude/worktrees/.gitkeep
