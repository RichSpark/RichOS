# Optional RichOS storage settings. Everything can remain commented out.
# Open ~/Library/Application Support/RichOS/.env with your editor or Finder Go to Folder.
# To store temporary work, caches and state together, uncomment RICHOS_BULK_ROOT= below
# and enter an existing absolute folder path after the equals sign.
# Example: RICHOS_BULK_ROOT=/your/storage/folder
# Do not add quotes. Spaces in a path are allowed.
# If you choose an external drive, RichOS refuses work while it is missing.
# It never silently moves that work to another drive.
# The remaining settings optionally choose a folder for one kind of storage.
# RICHOS_BULK_ROOT=
# CARGO_TARGET_DIR=
# RICHOS_CARGO_CACHE_ROOT=
# SCCACHE_DIR=
# RICHOS_SCCACHE_TMPDIR=
# RICHOS_BUILD_CACHE=
# RICHOS_RECOVERY_EVIDENCE_ROOT=
# RICHOS_RECOVERY_WIP_ROOT=
# RICHOS_CPU_GUARD_STATE=
# RICHOS_ENGINE_PASS_DIR=
# RICHOS_PROOF_RUN_DIR=
# RICHOS_AUTOCHECK_PROOF_ROOT=
# RICHOS_TEST_RESULTS_ROOT=
# RICHOS_ANDROID_CACHES_ROOT=
# RICHOS_NATIVE_IOS_CACHE=
# RANDROID_CACHE=
# RICHOS_GPL_SOURCE_CACHE=
# RICHOS_MOBILE_CACHE=
# RICHOS_PHONE_LOCK_DIR=
# RICHOS_PHONE_WATCH_HOME=
# RICHOS_PHYSICAL_STORE=
# RICHOS_PHYSICAL_PRODUCTS=
# GRADLE_USER_HOME=
# RICHOS_ENGINE_CHECK_PROOF_DIR=
# RICHOS_CAMPAIGN_PARENT=
