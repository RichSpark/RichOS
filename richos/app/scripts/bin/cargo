#!/usr/bin/env python3
"""Cargo with a private artifact directory for each physical workspace."""
from pathlib import Path
import runpy
import sys

sys.dont_write_bytecode = True

library = Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(library))
runpy.run_path(str(library / "cargo_identity.py"),
               run_name="__main__")
