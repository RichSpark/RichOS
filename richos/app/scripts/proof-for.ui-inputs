# ---- the harness's own behavior ------------------------------------------------------------
# The navigation capture in `lib/navigation-evidence.js` (reached by the library rule), proven
# against a fixture suite it runs as a child process and one load of the shipping shell.
navigation-evidence.js  @shell richos/app/ui/tests/fixtures/navigation-hang-suite.js richos/app/ui/tests/fixtures/loaded-host-preload.js richos/app/ui/tests/fixtures/stalled-host-preload.js
# The tracked-tree guard in `lib/tracked-tree.js` and `publishShot` in `lib/harness.js` (both
# reached by the library rule), and the one committed reference it reads, `shots-5c/` (reached
# by the shots rule: the suite names that directory). It opens no shipped screen, so it names no
# `ui/` source; its only declared input is the child suite it runs against a throwaway repository.
tracked-tree.js         richos/app/ui/tests/fixtures/tracked-tree-suite.js
# The gates that must be able to fail (part-2 hunt sections 25, 26 and 42): the harness's report
# and `publishShot` (library rule), `lib/page-errors.js` (library rule), `run.js`'s coverage floor
# and `appearance.js`'s error aggregate, which it reads as source. It opens no shipped screen.
gate-honesty.js         richos/app/ui/tests/run.js richos/app/ui/tests/appearance.js richos/app/ui/tests/fixtures/changed-shot-suite.js richos/app/ui/tests/fixtures/tiny-png.js
