{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RichOS",
  "identifier": "com.richos.app",
  "build": {
    "frontendDist": "../ui-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "create": false,
        "title": "RichOS",
        "width": 1400,
        "height": 880,
        "resizable": true,
        "visible": true,
        "zoomHotkeysEnabled": false,
        "acceptFirstMouse": true,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../docs/legal/THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../native/splash/starter/ruled-standard.mp4": "Splash/ruled-standard.mp4",
      "../native/splash/starter/ruled-standard.bar.json": "Splash/ruled-standard.bar.json",
      "../native/splash/starter/midnight-suede.mp4": "Splash/midnight-suede.mp4",
      "../native/splash/starter/midnight-suede.bar.json": "Splash/midnight-suede.bar.json",
      "../ui/assets/sounds/two-note.wav": "Splash/two-note.wav",
      "../ui/assets/sounds/two-note-grand.wav": "Splash/two-note-grand.wav"
    },
    "category": "Productivity",
    "shortDescription": "Talk to Rich.",
    "longDescription": "RichOS \u2014 the executive operating interface. One conversation with Rich.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RichSpark/RichOS/releases/latest/download/latest.json",
        "https://github.com/WebDevBooster/richos/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMjE4OTkxQzkyOEZEMEEKUldRSy9TakprWWtoTHhkSXQwVHpWeFBoNVh6MjR2RkdBVEk0ZDloOXZLbXVpaVNkd2p2Nko3KzIK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
