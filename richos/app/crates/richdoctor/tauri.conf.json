{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RichDoctor",
  "version": "1.0.0",
  "identifier": "com.richos.richdoctor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Utilities",
    "shortDescription": "Report a RichOS problem.",
    "longDescription": "RichDoctor helps you report a RichOS problem, even when RichOS cannot open.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": false
  }
}
